# ============================================================
# SECRETS — never commit
# ============================================================
# Real config with API keys, R2 credentials, Telegram tokens.
# Use config.example.yaml as a template; real config.yaml lives
# only on the server.
automation/config.yaml

# Environment files and keys
.env
.env.local
*.key
*.pem

# ============================================================
# Runtime state — generated by orchestrator, not source
# ============================================================
automation/logs/
automation/state/
automation/*.pid
automation/*.log
automation/*.log.*

# ============================================================
# Local data — separate directory, never in repo
# ============================================================
# All snapshots, SQLite, backups live in /home/solya/sonda_data/
# (parallel to /home/solya/sonda/, not inside).
sonda_data/

# ============================================================
# Python build artifacts
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# ============================================================
# Manual backups (from .bak.before_xxx patterns)
# ============================================================
*.bak
*.bak.*

# ============================================================
# Editor / IDE / OS junk
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# Test artifacts (rare, but possible)
# ============================================================
*.tmp
*.cache
